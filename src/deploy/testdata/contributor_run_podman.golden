-d
--name
hive-contributor-codex-<id>
--userns=keep-id:uid=1000,gid=1000
--memory
4g
--memory-swap
4g
--cpus
2
-v
<WORK>/home/.config/hive:/home/dev/.config/hive:Z
-v
<WORK>/home/.config/gh:/home/dev/.config/gh:ro,Z
-e
HIVE_HUB=wss://hive.hivecommons.dev/contribute
-e
AGENT_BACKEND=codex
-e
GH_TOKEN=placeholder-github-token
-e
HIVE_USE_CONTRIBUTOR_GH=true
-e
HIVE_CONTAINER_NAME=hive-contributor-codex-<id>
-e
HIVE_CONTAINER_RUNTIME=podman
-e
HIVE_CONTRIBUTOR_ENV=/home/dev/.config/hive/contributor.env
ghcr.io/hivecommons/hive-contributor:latest
