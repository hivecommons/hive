# The Hive service, as a Quadlet .container unit (#4354).
#
# ADR-0017 chose Quadlet as the Podman persistent lifecycle. This is the unit
# that decision was for. It runs the Hive service itself; the authenticating
# gateway that fronts it is hive-gateway.container and the network they share
# is hive.network (#4375).
#
# READINESS IS THE POINT. Notify=healthy generates Type=notify,
# NotifyAccess=all, and `podman run --sdnotify=healthy`, which holds the unit
# in `activating` until the healthcheck below passes. `systemctl start`
# returning therefore means Hive answered /api/health, not merely that a
# process was spawned. That property is why ADR-0017 chose Quadlet over
# `podman compose` and over a bare --restart=always container, and it is the
# reason HealthCmd= is set explicitly: the generator accepts Notify=healthy
# with no healthcheck and exits 0, producing a unit that reports "started" the
# moment conmon is up. A dry-run gate cannot catch that; only setting it can.
#
# BOTH ROOT MODES, ONE FILE. The bind-mount sources use %E, the systemd
# configuration-directory specifier: /etc for a system (rootful) unit and
# ~/.config for a --user (rootless) one. ADR-0017 warns that %h expands to
# /root in a system unit, so a unit written with %h is not portable across
# that boundary; %E is, and it puts the operator's files where each mode
# expects them.
#
# Podman version: ADR-0017 RECOMMENDS 5.6.0. The verified floor is UNKNOWN —
# nothing between 5.0.0 and 5.8.4 has been exercised, and 5.8.4 is only the
# version the spikes happened to run on, not a floor. Notify=healthy needs
# 5.0.0 at minimum. This unit joins no .pod, so the podman#26105 wrong-pod-name
# regression that motivates the 5.6.0 recommendation does not apply to it.

[Unit]
Description=Hive service
Documentation=https://github.com/kubestellar/hive/blob/v4/src/docs/podman-standalone-quadlet.md

[Container]
# From the one source of truth, src/deploy/standalone-images.sh (#4206), so the
# Podman and Docker assets cannot drift. src/deploy/test_standalone_image_refs.sh
# fails if this line stops agreeing with it. Fully qualified on purpose: the
# Quadlet generator warns on a short name and `podman auto-update` refuses one.
Image=ghcr.io/kubestellar/hive:stable
ContainerName=hive

# The #4210 ownership labels, matching hive_podman_labels in
# bin/hive-podman-cleanup.sh. They are what makes this container visible to
# bin/hive-podman-teardown.sh (#4343), whose selection is the ownership label
# set and nothing else — an unlabelled container is invisible to it and would
# survive every teardown. A Quadlet unit is static, so the instance label is
# the contract's default; a second deployment on one host needs its own unit
# with its own instance value.
Label=io.kubestellar.hive.owned=true
Label=io.kubestellar.hive.component=hive
Label=io.kubestellar.hive.instance=default
Label=io.kubestellar.hive.runtime=podman

# CAP_NET_ADMIN is what the entrypoint needs to install the forced-proxy egress
# redirect. Without it the entrypoint fails closed with exit 77 unless
# HIVE_PROXY_ADVISORY_OK=true is set deliberately — see the support matrix.
AddCapability=NET_ADMIN

# Persistent state. The .volume unit is referenced by unit name so the
# generated service orders itself after it.
Volume=hive-data.volume:/data

# The shared network (#4375). Referenced by unit name for the same reason as
# the volume: the generated service picks up Requires=/After=hive-network.service.
#
# This is what makes the container reachable as `hive` from the gateway, which
# is how src/deploy/nginx.conf finds its upstream. It is also the whole extent
# of the exposure: joining a network publishes nothing, so 3001, 3002 and 7681
# are reachable from other members of this network and from nowhere else.
Network=hive.network

# Operator-supplied configuration and secrets. %E is /etc for a rootful unit
# and ~/.config for a rootless one.
#
# :Z relabels private to this container, which is correct here because exactly
# one container uses these paths. Do NOT change it to :z for the secrets
# directory: :z is the shared label, and these are secrets. On a host without
# SELinux both are no-ops.
Volume=%E/hive/hive.yaml:/etc/hive/hive.yaml:ro,Z
Volume=%E/hive/secrets:/secrets:ro,Z

# Tokens and notification settings, kept out of the unit file.
#
# This file must EXIST — create it empty if every setting lives in hive.yaml.
# Quadlet does NOT honour systemd's leading `-` optional-file prefix here:
# `EnvironmentFile=-%E/hive/hive.env` generates cleanly and then resolves to
# `<unit dir>/-%E/hive/hive.env`, a path that will never exist, because the `-`
# stops the value looking absolute and Quadlet joins relative values to the
# unit directory. The dry-run does not warn about it. Measured on Podman 5.8.4;
# do not "restore" the dash.
EnvironmentFile=%E/hive/hive.env

# NO PublishPort, DELIBERATELY. The service listens on 3002 (API) and 3001
# (proxy), and 7681 is the raw writable ttyd terminal which must never be
# published — reaching it goes through the authenticating gateway on
# :3001/terminal, which authenticates first. The single published port on the
# host belongs to hive-gateway.container and is 3001 and nothing else, exactly
# as in src/docker-compose.yaml. src/deploy/test_quadlet_port_boundary.sh fails
# the build if a PublishPort= appears here.

# READINESS. HealthCmd is required for Notify=healthy to mean anything; see the
# header. /api/health is the same endpoint the Kubernetes readiness probe and
# the Compose healthcheck use, so "healthy" means the same thing on all three.
#
# THE PORT BELOW IS COUPLED TO `dashboard.port` IN THE MOUNTED hive.yaml, and
# nothing enforces the coupling. 3002 is the Go default (defaultDashboardPort in
# pkg/config/config.go), what src/deploy/hive.yaml sets, and what the Compose
# healthcheck probes — but src/hive.yaml.example ships 3001 for source runs.
# Install that file unchanged and Hive serves on 3001, this probe never answers,
# and Notify=healthy correctly holds the unit in `activating` for the whole
# TimeoutStartSec below before --rm deletes the evidence. Change one, change the
# other (#4367).
Notify=healthy
HealthCmd=curl -sf http://127.0.0.1:3002/api/health
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=120s

[Service]
# ADR-0017: every .container unit must set TimeoutStartSec explicitly, larger
# than HealthStartPeriod plus the retry budget (120s + 3x10s = 150s here). The
# host default is NOT a safe fallback — it was measured at 45s on Fedora and
# 90s on the GitHub runners, both below the start period, and the generated
# ExecStart carries --rm, so a timeout deletes the container that holds the
# evidence of why it timed out.
TimeoutStartSec=300
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
