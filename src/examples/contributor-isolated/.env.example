# Copy to .env. These are Compose settings, not a shell script.
# Pick a unique project name for each bot; it also namespaces its home volume.
COMPOSE_PROJECT_NAME=hive-bot
HIVE_HUB=wss://hive.hivecommons.dev/contribute
HIVE_CONTRIBUTOR_IMAGE=ghcr.io/hivecommons/hive-contributor:latest
AGENT_BACKEND=codex
# Empty model/effort uses the backend defaults. The hub must accept your model.
AGENT_MODEL=
AGENT_REASONING_EFFORT=
HIVE_CONTAINER_MEMORY=4g
HIVE_CONTAINER_CPUS=2
# 0 = normal priority; 1..19 yields more CPU time under contention.
HIVE_CONTRIBUTOR_NICE=10
