{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hivecommons/hive/src/pkg/evidence/schema/v1.json",
  "title": "Hive review evidence bundle, schema v1",
  "type": "object",
  "required": ["schema_version", "id", "repo", "number", "author", "base_sha", "head_sha", "policy", "ci", "created_at", "updated_at", "signed"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "v1"},
    "id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "number": {"type": "integer", "minimum": 1},
    "author": {
      "type": "object",
      "required": ["login", "kind"],
      "additionalProperties": false,
      "properties": {
        "login": {"type": "string", "minLength": 1},
        "kind": {"enum": ["human", "agent", "bot"]},
        "agent": {"type": "string"},
        "backend": {"type": "string"},
        "model": {"type": "string"}
      }
    },
    "base_sha": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "minLength": 1},
    "previous_bundle_id": {"type": "string"},
    "policy": {
      "type": "object",
      "required": ["acmm_level", "require_approval"],
      "additionalProperties": false,
      "properties": {
        "acmm_level": {"type": "integer"},
        "perspectives": {"type": "array", "items": {"type": "string"}},
        "require_approval": {"type": "boolean"},
        "min_priority": {"type": "string"},
        "human_merge_paths": {"type": "array", "items": {"type": "string"}},
        "sentinel_config_hash": {"type": "string"}
      }
    },
    "verdicts": {"type": "array", "items": {"$ref": "#/$defs/verdict"}},
    "posted_reviews": {"type": "array", "items": {"$ref": "#/$defs/posted_review"}},
    "ci": {
      "type": "object",
      "required": ["captured_at"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["success", "failure", "pending"]},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "captured_at": {"type": "string", "format": "date-time"}
      }
    },
    "sentinel": {"type": "array", "items": {"$ref": "#/$defs/sentinel_finding"}},
    "human_actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "merge": {
      "type": "object",
      "required": ["actor", "method", "at", "sha"],
      "additionalProperties": false,
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "at": {"type": "string", "format": "date-time"},
        "sha": {"type": "string", "minLength": 1},
        "opened_at": {"type": "string", "format": "date-time"}
      }
    },
    "revert_of": {"$ref": "#/$defs/bundle_ids"},
    "followup_of": {"$ref": "#/$defs/bundle_ids"},
    "reverted_by": {"$ref": "#/$defs/bundle_ids"},
    "followed_up_by": {"$ref": "#/$defs/bundle_ids"},
    "issue_reopens": {"type": "array", "items": {"$ref": "#/$defs/issue_reopen"}},
    "issue_closures": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["repo", "issue", "at", "clarity_gate"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "issue": {"type": "integer", "minimum": 1},
        "at": {"type": "string", "format": "date-time"},
        "clarity_gate": {"type": "boolean"}
      }
    }},
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_gate": {"$ref": "#/$defs/shadow_review_gate"},
        "intent": {"$ref": "#/$defs/shadow_intent"}
      }
    },
    "control_window": {"enum": ["on", "off"]},
    "backfilled": {"type": "boolean"},
    "backfill": {
      "type": "object",
      "required": ["source", "at"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "at": {"type": "string", "format": "date-time"},
        "state": {"type": "string", "enum": ["open", "closed", "merged"]},
        "closed_at": {"type": "string", "format": "date-time"},
        "author_kind_rule": {"type": "string"},
        "flags": {"type": "array", "items": {"type": "string", "enum": ["placeholder_hive", "hive_on_hive", "under_min_merged"]}}
      }
    },
    "outcome": {
      "type": "object",
      "required": ["source", "state", "at"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "state": {"type": "string", "enum": ["open", "closed", "merged"]},
        "at": {"type": "string", "format": "date-time"},
        "merged_by": {"type": "string"},
        "merged_at": {"type": "string", "format": "date-time"},
        "closed_at": {"type": "string", "format": "date-time"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "signed": {"type": "boolean"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string"}
  },
  "$defs": {
    "bundle_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "issue_reopen": {
      "type": "object",
      "required": ["issue", "at", "source"],
      "additionalProperties": false,
      "properties": {
        "issue": {"type": "integer", "minimum": 1},
        "repo": {"type": "string"},
        "at": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "verdict": {
      "type": "object",
      "required": ["perspective", "model", "backend", "verdict", "confidence", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "perspective": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "backend": {"type": "string"},
        "verdict": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_raw": {"type": "number"},
        "confidence_derived": {"type": "number", "minimum": 0, "maximum": 1},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "finding": {
      "type": "object",
      "required": ["path", "line", "severity", "summary"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 0},
        "severity": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "posted_review": {
      "type": "object",
      "required": ["url", "head", "at"],
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "head": {"type": "string", "minLength": 1},
        "at": {"type": "string", "format": "date-time"}
      }
    },
    "check": {
      "type": "object",
      "required": ["name", "conclusion"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "conclusion": {"type": "string", "minLength": 1},
        "url": {"type": "string"}
      }
    },
    "sentinel_finding": {
      "type": "object",
      "required": ["rule", "summary"],
      "additionalProperties": false,
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "shadow_review_gate": {
      "type": "object",
      "required": ["would_have_held", "confidence", "evaluated_at"],
      "additionalProperties": false,
      "properties": {
        "would_have_held": {"type": "boolean"},
        "reason": {"type": "string"},
        "tier": {"type": "string"},
        "lane": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "shadow_intent": {
      "type": "object",
      "required": ["would_have_blocked", "confidence", "evaluated_at"],
      "additionalProperties": false,
      "properties": {
        "would_have_blocked": {"type": "boolean"},
        "reason": {"type": "string"},
        "tier": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "action": {
      "type": "object",
      "required": ["actor", "kind", "at"],
      "additionalProperties": false,
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
