#!/bin/sh
# Fake Spektacular CLI for hivecommons/hive#8303 tests.
#
# It emits the per-artifact status contract as shipped by
# jumppad-labs/spektacular#45 (hivecommons/hive#8301) from a scripted sequence
# so the Hive runner can be exercised end to end through BinaryExec without
# the real Spektacular repository. Hive never reads this file's state: the
# counter below is the fake's own bookkeeping, hidden behind the CLI boundary.
#
# Contract encoded here (see src/docs/spektacular.md):
#   spektacular <spec|plan> status <name>           (bare name, no extension;
#                                                    the CLI has no --json flag)
#     -> {"error":false,"kind","name","document_status":"draft"|"final",
#         "current_step","completed_steps":[],"created_at","updated_at",
#         "closed_at","spec","plan"}
#        created_at / closed_at are frontmatter dates emitted as RFC3339
#        midnight UTC, "" when unset; updated_at is workflow activity only
#        while the in-progress state matches the artifact, otherwise a file
#        mtime, and may be absent altogether; spec / plan are the frontmatter
#        cross-references and are almost never populated.
#     missing artifact -> non-zero exit and the JSON error envelope
#        {"error":true,"code":"artifact_not_found","message":"...",
#         "resource":"<name>","next_action":"..."} on stdout
#   spektacular plan export <name> --format json
#                                    (still an open ask on the Spektacular
#                                     side; shape assumed)
#     -> {"error":false,"kind":"plan","name",
#         "tasks":[{"ref","title","depends_on","execution"}]}
#
# Environment:
#   SPEK_FAKE_SCENARIO  draft-final | never-final | final-then-draft |
#                       final-no-updated-at | missing
#   SPEK_FAKE_STATE     path of the per-scenario call counter file
set -eu

kind="${1:-}"; verb="${2:-}"; name="${3:-}"; extra="${4:-}"; format="${5:-}"
scenario="${SPEK_FAKE_SCENARIO:-draft-final}"
state="${SPEK_FAKE_STATE:?SPEK_FAKE_STATE is required}"

# Exit codes the fake uses. The real CLI exits non-zero on every envelope
# error; the exact code is not part of the contract.
EXIT_USAGE=64
EXIT_NOT_FOUND=1

usage_error() {
  printf '{"error":true,"code":"usage","message":"%s","next_action":"see spektacular --help"}\n' "$1"
  exit "$EXIT_USAGE"
}

# The real CLI has no --json flag (its only global flag is --fields); an
# unknown flag is a usage error, which is what a caller still passing it
# would see.
if [ -n "$extra" ] && { [ "$verb" != "export" ] || [ "$extra" != "--format" ] || [ "$format" != "json" ]; }; then
  usage_error "unknown flag: $extra"
fi

# Status and export verbs take the bare artifact name. A file address
# (`<name>.md`, `<name>/plan.md`) is not an artifact and is reported missing,
# which is what the real store answers for it.
case "$name" in
  *.md|*/*)
    printf '{"error":true,"code":"artifact_not_found","message":"%s artifact \\"%s\\" was not found","resource":"%s","next_action":"run `spektacular %s file list` to see available %ss"}\n' "$kind" "$name" "$name" "$kind" "$kind"
    exit "$EXIT_NOT_FOUND"
    ;;
esac

count=0
if [ -f "$state" ]; then
  count=$(cat "$state")
fi

if [ "$verb" = "export" ]; then
  if [ "$kind" != "plan" ]; then
    usage_error "only plans export"
  fi
  printf '{"error":false,"kind":"plan","name":"%s","tasks":[{"ref":"T1","title":"Add encoding helpers","execution":"agent_suitable"},{"ref":"T2","title":"Wire helpers into the parser","depends_on":["T1"],"execution":"agent_suitable"},{"ref":"T3","title":"Sign off on the public API","depends_on":["T2"],"execution":"human_required"}]}\n' "$name"
  exit 0
fi

if [ "$verb" != "status" ]; then
  usage_error "unknown verb: $verb"
fi

count=$((count + 1))
printf '%s' "$count" > "$state"

with_updated=1
case "$scenario" in
  missing)
    printf '{"error":true,"code":"artifact_not_found","message":"%s artifact \\"%s\\" was not found","resource":"%s","next_action":"run `spektacular %s file list` to see available %ss"}\n' "$kind" "$name" "$name" "$kind" "$kind"
    exit "$EXIT_NOT_FOUND"
    ;;
  never-final)
    status=draft
    ;;
  final-then-draft)
    if [ "$count" -le 1 ]; then status=final; else status=draft; fi
    ;;
  final-no-updated-at)
    # A closed artifact with no matching workflow state: Spektacular may drop
    # updated_at entirely rather than report a file mtime.
    status=final
    with_updated=0
    ;;
  draft-final|*)
    if [ "$count" -le 2 ]; then status=draft; else status=final; fi
    ;;
esac

# Frontmatter dates: created_date / closed_date as RFC3339 midnight UTC,
# closed_at "" while the document is open.
closed='""'
steps='["interview"]'
step='authoring'
if [ "$status" = "final" ]; then
  closed='"2026-09-22T00:00:00Z"'
  steps='["interview","authoring","review"]'
  step='finished'
fi
# The plan cross-reference is populated for a spec only in the rare case the
# author filled it in; the fake mirrors the common case (empty) for specs and
# the self-reference for plans, which is what the #45 example shows.
plan=''
if [ "$kind" = "plan" ]; then plan="$name"; fi

if [ "$with_updated" -eq 1 ]; then
  printf '{"error":false,"kind":"%s","name":"%s","document_status":"%s","current_step":"%s","completed_steps":%s,"created_at":"2026-09-21T00:00:00Z","updated_at":"2026-09-22T13:3%s:00Z","closed_at":%s,"spec":"","plan":"%s"}\n' \
    "$kind" "$name" "$status" "$step" "$steps" "$count" "$closed" "$plan"
else
  printf '{"error":false,"kind":"%s","name":"%s","document_status":"%s","current_step":"%s","completed_steps":%s,"created_at":"2026-09-21T00:00:00Z","closed_at":%s,"spec":"","plan":"%s"}\n' \
    "$kind" "$name" "$status" "$step" "$steps" "$closed" "$plan"
fi
