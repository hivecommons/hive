# Pinned to the golang:1.27-alpine multi-arch index digest to prevent
# floating-tag supply-chain risk. Refresh deliberately (same technique as
# src/Dockerfile: resolve via auth.docker.io token + HEAD manifest for repo
# library/golang, tag 1.27-alpine) and update both the tag and the @sha256
# digest together.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder
RUN apk add --no-cache git
WORKDIR /src

COPY .git /repo/.git
COPY src/ .
# GIT_BRANCH must be stamped in, exactly as src/Dockerfile does for the spoke.
# The hub SELF-UPGRADES by polling GHCR for the head SHA of its OWN branch
# (s.hubGitBranch, from main.gitBranch). Without this ldflag the binary carries
# the "unknown" default, NewHubServer coerces it to "v2", and a hub built from
# ANY other branch pins itself back to v2's SHA every poll — silently reverting
# a v4 deployment ~60s after it rolls out. Deriving it from the checkout is the
# fallback for local builds; CI passes GIT_BRANCH explicitly because the .git
# copy is often in a detached HEAD state.
ARG GIT_BRANCH=unknown
# VERSION mirrors src/Dockerfile: when no build-arg is passed the RUN below
# derives it from `git describe --tags --always` against the copied
# /repo/.git, so the hub image self-stamps a real semver ("4.34.0",
# "4.34.0-7-gSHA") instead of the "0.0.0-dev" fallback. tagged-release.yml
# retags rather than rebuilds, so the value must be embedded at this original
# docker.yml build — which checks out with fetch-depth: 0 for the tag history
# git describe needs. See the longer comment in src/Dockerfile and
# src/docs/releases.md, "The version constant".
ARG VERSION=""
ARG TARGETOS
ARG TARGETARCH
RUN GIT_HASH=$(git -C /repo rev-parse HEAD 2>/dev/null || echo "unknown") && \
    GIT_SHORT=$(git -C /repo rev-parse --short=7 HEAD 2>/dev/null || echo "unknown") && \
    if [ "$GIT_BRANCH" = "unknown" ] || [ -z "$GIT_BRANCH" ]; then GIT_BRANCH=$(git -C /repo rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown"); fi && \
    VERSION_LDFLAG="" && \
    RESOLVED_VERSION="$VERSION" && \
    if [ -z "$RESOLVED_VERSION" ]; then RESOLVED_VERSION=$(git -C /repo describe --tags --always 2>/dev/null || echo ""); fi && \
    if [ -n "$RESOLVED_VERSION" ]; then VERSION_LDFLAG="-X main.version=${RESOLVED_VERSION}"; fi && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags "-X main.gitHash=${GIT_HASH} -X main.gitShort=${GIT_SHORT} -X main.gitBranch=${GIT_BRANCH} ${VERSION_LDFLAG}" -o /hive ./cmd/hive

# Named `runtime` so the CI hub build step can list it in `no-cache-filters`
# alongside `builder`. Busting only `builder` rebuilt a fresh /hive but let
# BuildKit serve the final-stage `COPY --from=builder /hive` layer from the
# branch-scoped GHA cache, shipping the OLD binary. See docker.yml.
# Digest-pinned (#3843): a bare `alpine:3.24` tag is mutable — Alpine re-pushes
# the patch tag on every CVE respin, so the trusted computing base of the hub
# image could change with no diff in this repo. Every other FROM here was
# already digest-pinned; this was the last tag-only one. Digest resolved from
# docker.io/library/alpine:3.24 (an OCI index, so it stays multi-arch — the
# amd64/arm64 hub builds both still work).
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS runtime
ARG TARGETARCH
ARG KUBECTL_VERSION=v1.36.3
ARG KUBECTL_SHA256_AMD64=ebbd080e7c2e275093b55915722043257eb24004363e20acb3c4d71919f88336
ARG KUBECTL_SHA256_ARM64=3d86f24401c41ae5a46ac50eef8865fe891d3647d324a0836f6c63757a126e62
RUN apk add --no-cache ca-certificates curl && \
    ARCH="${TARGETARCH:-$(uname -m)}" && \
    case "$ARCH" in \
      amd64|x86_64) KUBECTL_ARCH=amd64; KUBECTL_SHA256="$KUBECTL_SHA256_AMD64" ;; \
      arm64|aarch64) KUBECTL_ARCH=arm64; KUBECTL_SHA256="$KUBECTL_SHA256_ARM64" ;; \
      *) echo "unsupported arch for kubectl: $ARCH" >&2; exit 1 ;; \
    esac && \
    curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${KUBECTL_ARCH}/kubectl" && \
    echo "${KUBECTL_SHA256}  /usr/local/bin/kubectl" | sha256sum -c - && \
    chmod +x /usr/local/bin/kubectl
# #10097: no Spektacular install here. HIVE_MODE=hub returns from boot()
# before bootDashboardAPIWith (cmd/hive/main.go) ever runs, and that's the
# only place the Spektacular runner gets wired up — the hub never invokes the
# CLI, so shipping the binary in this image was dead weight. src/Dockerfile
# and src/Dockerfile.contributor still install it for the spoke/contributor
# images, which do boot the dashboard.
COPY --from=builder /hive /usr/local/bin/hive
RUN chmod +x /usr/local/bin/hive
RUN mkdir -p /data /etc/hive
EXPOSE 80
ENV HIVE_MODE=hub
ENTRYPOINT ["hive"]
CMD ["--config", "/etc/hive/hive.yaml"]