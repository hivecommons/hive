# Hive v2 Configuration
# All values support ${ENV_VAR} interpolation for secrets.
# Copy this file to hive.yaml and customize for your setup.
#
# Dynamic overrides: place a config.env file next to hive.yaml (or at
# /etc/hive/config.env) with KEY=VALUE lines. These override yaml values.
# Precedence: hive.yaml < config.env < explicit env vars.

project:
  # Replace your-org, repo-*, and your-bot-user before use.
  org: your-org                          # GitHub organization
  repos:                                 # Repositories to manage
    - repo-one
    - repo-two
  ai_author: your-bot-user               # Login agents author as. Leave unset on App-authenticated hives (the App bot is used). Never a maintainer's own login: Hive treats this account as itself and ignores its /hive commands.
  primary_repo: repo-one                 # Main repo for priority routing
  # agent_issue_decision_policy: resolve # resolve (default) lets Hive-authored issues stay actionable for non-risk engineering choices; escalate parks every --needs-decision request
  # Optional: host-local directory holding one checkout per repo, as
  # <checkouts_dir>/<repo name>. Supplies the repo root Hive reads AGENTS.md
  # from at kick time (src/docs/agents-md.md). Hive agents work over the API and
  # keep no clones, so without this AGENTS.md injection stays a no-op — which is
  # the default. An absent directory or a repo with no AGENTS.md is also a no-op.
  # checkouts_dir: /data/checkouts
  # Optional: hive-wide house style — a short how-to-change rule list that
  # opens every kick on every backend (src/docs/house-style.md). A repo's root
  # HIVE_STYLE.md (read from checkouts_dir) overrides it; unset both and the
  # built-in text applies. `style` (inline) wins over `style_file`.
  # style: |
  #   - Prefer table-driven tests.
  # style_file: /etc/hive/HIVE_STYLE.md
  # style_max_bytes: 4096                # min 512; oversize candidates are skipped, not clipped
  # Optional: quiet ONE repo without stopping the hive (src/docs/repo-pause.md).
  # A paused repo stays in `repos` above — it keeps its dashboard card and its
  # ACMM eval — but agents cannot write to it and are handed no work on it. Only
  # `repo` is required; `by`/`at`/`reason` are the provenance the dashboard and
  # POST /api/repos/pause fill in, and are what stops an unexplained quiet repo
  # from becoming a support ticket a week later. Absent = nothing paused.
  # paused_repos:
  #   - repo: repo-two
  #     by: your-github-login
  #     reason: release freeze until Friday

# Optional opt-in "clanker-requested" policy, under project.issue_filter.reporter_trust.
# Off by default. While on, a PR carrying the label below is treated as held.
# project:
#   issue_filter:
#     reporter_trust:
#       clanker_requested: true                       # default: false
#       clanker_requested_label: clanker-requested    # default: clanker-requested; must not be blank
#       clanker_requested_addendum: ""                # optional free text, max 1000 bytes

# Optional merge-request safety exceptions. Hive now merges into any protected
# or unprotected base branch the App can write, while still refusing a PR with
# zero statuses + zero check runs + zero workflow runs. `allow_unprotected_base`
# is accepted as a deprecated no-op for old configs; list only repos that
# intentionally have no CI in `no_ci_ok`.
# auto_merge:
#   allow_unprotected_base:
#     - legacy-entry-no-longer-needed
#   no_ci_ok:
#     - your-org/docs-only-repo
#   # One human step per agent PR at ACMM L5 (src/docs/hive-merge.md): a trusted
#   # merger's Approve review on the current head plus removing the level hold
#   # queues the PR for auto-merge. Per repo, off by default.
#   queue_on_approve_and_unhold:
#     - your-org/your-repo
#   # Contributor-lane tier (src/docs/hive-merge.md#contributor-lane-auto-merge):
#   # merges a green, soaked, reviewer-approved PR from a contributor the
#   # operator trusts. The author is admitted either by holding a require_tiers
#   # tier on their contributor-registry profile (registry_tiers_sufficient,
#   # default true) or by closing an issue that carries this hive's verified
#   # hive:claim marker for them.
#   contributor_lane:
#     enabled: true
#     soak_minutes: 120
#     require_reviewer_verdict: true
#     require_tiers: [trusted, merger]
#     registry_tiers_sufficient: true

# Optional suspicious-activity alerts. Default: enabled, `sentinel-alert` is a
# hard block for untrusted authors, and trusted authors (Hive App, owner-tier
# authorized users, allow-listed bots) receive informational notices only.
# sentinel:
#   trusted_authors_block: false  # set true to block trusted authors too

# Hive-curated `good first issue` advertising (default ON; `enabled: false`
# opts out). A periodic sweep scores open, unclaimed issues; the few that qualify get
# GitHub's canonical `good first issue` + `help wanted` labels and ONE welcome
# comment that pitches the issue to contributors bringing their own coding
# agent and links this hive's relay page (<dashboard.public_url>/contribute?
# issue=<owner/repo>#<n>). Not a hold: when a hive agent starts the issue the
# label comes off and the comment is marked superseded. Needs
# dashboard.public_url (or a hub-assigned dashboard URL).
# See docs/good-first-issue.md.
# good_first_issue:
#   enabled: true           # default; false opts out
#   interval: 15m           # sweep cadence (short: the scanner claims fresh issues within minutes)
#   max_per_repo: 5         # issues wearing the label per repo, including hand-labelled
#   max_per_sweep: 2        # new selections per repo per pass
#   min_age: 1h             # never advertise an issue younger than this
#   min_body_chars: 80
#   max_body_chars: 4000
#   max_packages: 2         # source directories an issue may mention
#   min_score: 2            # positive signals required
#   reselect_cooldown: 168h # a released issue stays out this long
#   exclude_labels: [kind/epic, epic, meta, security]  # replaces the built-in list
#   repos: []               # empty = every watched repo
#   docs_url: https://github.com/hivecommons/hive/blob/v5/src/docs
#   comment_template: ""    # text/template over gfi.Vars; must contain {{ .Marker }}

# Optional contributor help/community links. Shown on /contribute Onboarding,
# Operations, and printed by relays when they connect. Empty/omitted defaults to
# Hive's contributor docs and issue tracker. URLs must be absolute http(s).
# Prefer discord.gg invites over discord.com/channels URLs for new contributors.
# contribute:
#   # Registration tokens: mandatory lifetime; optional inactivity cutoff.
#   # Env overrides: HIVE_CONTRIBUTE_TOKEN_MAX_AGE / HIVE_CONTRIBUTE_TOKEN_IDLE_MAX.
#   token_max_age: 2160h # 90 days (Go durations do not accept days)
#   token_idle_max: 0s # off
#   help_links:
#     - label: Contributor docs
#       url: https://github.com/hivecommons/hive/blob/v5/src/docs/contributor-relay.md
#     - label: Chat with other contributors
#       url: https://hivecommons.dev/discord
#   # Stage-072 fix budget (hivecommons/hive#12436): how many red-PR fix-pr
#   # sub-sessions one contributor's relay may run beside its primary session
#   # (the relay advertises its own count; the hub clamps to this). 1 forces
#   # preempt mode. Queued fixes are served before new work.
#   max_parallel_fixes: 2
#   # Preempt mode: minimum uninterrupted run time of a resumed primary task
#   # before the hub may preempt that contributor again.
#   min_focus_window: 30m

# GitHub App / PR policy. The #5117 self-authorization hold defaults on through
# ACMM L5 and off at ACMM L6 (Autonomous). App-authored PRs whose only
# tracked rationale is an unacknowledged hive-filed issue receive `hold` until a
# human signs off on the direction. Set true to keep that hold at L6; set false
# below L6 only for hives that are allowed to act on their own findings.
# github:
#   self_authorization_hold: true
#
# Issue lifecycle automation. Defaults shown: after a hive/trusted fix PR
# merges, Hive posts a close marker and closes the fixed issue as completed
# itself, because GitHub only auto-closes keyword-linked PRs that target the
# repository default branch. Add `hive: needs-confirmation` to a specific
# issue, or set reporter_confirmation: true globally, only when human-filed
# bug issues must wait for reporter verification before closing.
# issues:
#   close_on_merge: true
#   close_on_merge_backfill_interval: 1h
#   reporter_confirmation: false
#   # Trusted reporters' SHA-less bugs get this soft label, not `hold` (#12002).
#   sha_hold_trusted_label: needs-sha
#   # Lift hive-applied hold/blocked once a referencing PR merges (#12002).
#   lift_hive_hard_suppress: true
#   hard_suppress_reconcile_interval: 30m
#   # Comment once on new RFC/feature issues with the existing settings that
#   # may already cover them; never labels or closes (#13575). Default off.
#   rfc_existing_check:
#     enabled: false
#     post_when_nothing_found: false
#     labels: [rfc, enhancement, kind/feature]
#     max_matches: 5
#     max_age: 168h
#
# Optional per-repo override for the same policy. Omit a repo entry (or omit
# self_authorization_hold in it) to inherit github.self_authorization_hold, then
# the live ACMM-level default when the hive-wide setting is also unset.
# project:
#   repo_policies:
#     - repo: console
#       self_authorization_hold: false
#     - repo: sensitive-repo
#       auto_merge: false  # PRs may be opened, but Hive will not merge them.
#     - repo: serialized-repo
#       # How Hive merges here: direct (default) or hive-serialized. It decides
#       # how, never whether — auto-merge level, auto_merge, pauses and holds
#       # still apply. An unrecognised value is a config error and Hive will
#       # not merge into that repo. Unrelated to knowledge.primer.merge_strategy.
#       # Downgrading to a Hive without this key silently ignores it, and the
#       # repo goes back to direct.
#       merge_strategy: hive-serialized
#     - repo: busy-repo
#       # Cap on open hive PRs still waiting on a human (#13645). At the cap
#       # hive-open-pr refuses new PRs here; issue filing is unaffected. 0 means
#       # the default of 12; omit the key for no cap.
#       max_open_held_prs: 0
  # Optional: how the issues and PRs your agents file should read. Rendered as
  # ${WRITING_GUIDE} in every default policy that files an issue or PR, right
  # before the body template the agent fills in — next to the template, which
  # is where a style rule has to sit to be followed (a rule in AGENTS.md
  # arrives as background and loses to the template). Also carried into the
  # contributor relay's task prompt, so PRs a contributor opens for your repos
  # read the same way your own agents' do. Empty (the default) renders nothing.
  # See src/docs/agent-configuration.md.
  # writing_guide: |
  #   A person who was not in your head will read this. Write for them.
  #   Open with two or three short sentences: what changed, why, and what
  #   to look at. Short sentences. One idea per bullet. Put evidence under a
  #   <details> block and keep it to about 300 words outside that block.

# Optional upstream watch for forked repos (src/docs/upstream-watch.md). Off by
# default. Keys under repos must be listed in project.repos. If `upstream` is
# omitted it is resolved from the GitHub fork parent at runtime.
# upstream_watch:
#   enabled: true
#   interval: 6h                       # default 6h
#   repos:
#     repo-one:
#       upstream: origin-owner/thing   # optional owner/repo
#       sources: [releases, prs]       # default: both
#       pr_labels: [bug, security]     # empty = all merged PRs
#       max_issues_per_run: 5          # omit = no cap
#       label: upstream/port           # default upstream/port

ioscan:
  enabled: true                           # default: true; scans untrusted text before agent kicks
  fail_mode: open                         # default: open at L1–L4, closed at ACMM L5–L6 (packs); open redacts, closed blocks Critical injection kicks and canary leaks
  canaries: true                          # default: true (nil == on); set false to opt out. Plants per-kick exfiltration canaries and scans agent egress
  classifier:
    enabled: false                        # default: false; optional LLM judge for semantic plain-English injections
    model: ""                             # empty uses governor.litellm default_model, then gpt-4o-mini
    backend: ""                           # empty = HTTP endpoint; "claude" runs the classifier through the tool-less CLI (copilot/codex/gemini refused at boot)
    cli_budget_per_eval: 8                # CLI backend only: classifier calls per scheduler pass
    cli_daily_quota: 500                  # CLI backend only: classifier calls per UTC day
    warn_threshold: 0.55                  # advisory bead/audit threshold
    block_threshold: 0.85                 # open=redact, closed=block kick

# Spoke-wide backend allow/deny list (optional). Deny wins; an empty allow
# means every backend is allowed. ACMM pack apply never places an agent on a
# disallowed backend (it falls back to the first allowed entry, else the hive
# default, and moves pack-owned agents off it), and
# PUT /api/config/agent/{name}/models rejects such a placement with 400.
# backends:
#   allow: [claude, codex]
#   deny: [copilot]

# Agent CLAUDE.md policies from a git config repo (optional).
# Uncomment and set to your own policy repo if you have custom agent prompts.
# policies:
#   repo: https://github.com/your-org/hive-config
#   path: agents/
#   local_dir: /data/policies
#   poll_interval: 5m

# Agent definitions — each agent runs as a child process.
# All behavior metadata (color, sort, keywords, etc.) is optional and auto-populated
# for known agent names. New/custom agents should set these fields explicitly.
agents:
  # github_api_hourly_cap: 300            # Per-agent charged GitHub API responses/hour through the proxy; 0 disables.
  scanner:
    # id: scan-01                         # Stable internal key (defaults to YAML key)
    enabled: true
    backend: claude                       # claude | copilot | gemini | goose | bob | pi | codex | aider | vllm | llm-d | litellm | watsonx
    model: claude-sonnet-4-6
    # caveman_mode: lite                  # optional, experimental: lite | full | ultra | wenyan; omit to disable
    # jev_mode: assist                    # optional: give the agent the Jev typed-decision tool (off | assist); omit to disable
    beads_dir: /data/beads/scanner
    # replicas: 3                         # Optional pool: scanner, scanner-2, scanner-3 (max 5)
    clear_on_kick: true                   # Send /clear before each kick to reset context
    display_name: Code Scanner
    description: Triages GitHub issues and PRs — dispatches fix agents, enforces SLA
    role: scanner                         # Semantic role for behavioral dispatch
    sort_order: 20                        # Sidebar ordering (lower = higher)
    emoji: "🔍"                           # Discord identity
    color: "#3498db"                      # Dashboard color (hex)
    aliases: ["sc"]                       # Discord shortcodes
    lane_keywords: ["bug", "triage", "typo", "fix"]  # Issue classification routing
    detect_keywords: ["scanner", "triage", "issue", "bug"]  # Token session detection
    kick_template: scanner-CLAUDE.md      # Prompt template filename (or omit for convention)
    include_repos: true                   # Append repos section to kicks (prompt text only —
                                          #   authorizes repos, does not clone them)
    # task_mcp:
    #   drop_stuffed_context: false       # When a hub task MCP URL is present, render
                                          #   ISSUE_LIST/PR_LIST/MERGE_ELIGIBLE as
                                          #   repo#N refs only; default false.
    # repos: [repo-one]                   # WHICH repos this agent serves. Omit (the default)
                                          #   for the whole hive. Naming repos makes the agent
                                          #   a specialist: handed work only on these, its
    # github_api_hourly_cap: 200          # Optional per-agent override; 0 disables this agent's cap.
                                          #   $HIVE_REPO/$HIVE_REPOS follow, and writes to any
                                          #   other repo are REFUSED by the proxy and the
                                          #   hive-open-pr / hive-merge / hive-open-issue
                                          #   relays. See src/docs/per-repo-agents.md.
    bead_role: worker                     # "supervisor" or "worker"
    # stats_display:                      # Custom stats for sidebar (omit for defaults)
    #   - key: actionable
    #     label: Actionable
    #     source: status
    #     field: actionableCount
    #     style: spark
    #     trend_field: actionable
    # channels:                             # Trigger channels (omit = governor kicks only)
    #   - type: kick                        # Keep governor timer kicks
    #   - type: webhook                     # Also trigger on GitHub events
    #     events: ["issues.opened", "issues.labeled"]
    #   - type: bead                        # Trigger on matching bead metadata
    #     match: { nudge_target: scanner }
    # tools:                                # Declarative tool permissions (overrides mode)
    #   preset: full                        # advisory | issues-only | issues-prs | full
    #   rules:
    #     - pattern: "mcp__github__delete_*"
    #       action: deny
    #       reason: "scanners should not delete repos"
    # connections:                           # External service integrations
    #   - name: github-mcp
    #     type: mcp
    #     uri: "stdio:///usr/local/bin/mcp-github"
    #   - name: jira
    #     type: api
    #     uri: "https://jira.example.com/rest/api/2"
    #     auth:
    #       type: env
    #       env_var: JIRA_TOKEN
    #     env_name: JIRA_BASE_URL
  reviewer:
    enabled: true
    backend: copilot
    model: claude-fable-5
    role: reviewer
    mode: ADVISORY
    converse: true
    kick_template: reviewer-queue.md
    include_repos: true
    clear_on_kick: true
    review_models:
      pool:
        - {backend: copilot, model: gpt-5.6-terra}
        - {backend: copilot, model: gemini-3.7-flash}
        - {backend: copilot, model: claude-opus-4-6}
      exclude_author_model: true     # default true; never review with the author model
      exclude_author_family: false   # default false; true also skips same vendor prefix
      fallback: pinned               # pinned | skip | requires_human
  ci-maintainer:
    enabled: true
    backend: claude
    model: claude-sonnet-4-6
    beads_dir: /data/beads/ci-maintainer
    clear_on_kick: true
    display_name: CI Maintainer
    description: Post-merge quality gate — monitors CI health, coverage, GA4 errors
    sort_order: 30
  quality:
    enabled: true
    backend: claude
    model: claude-sonnet-4-6
    beads_dir: /data/beads/quality
    clear_on_kick: true
    display_name: Quality
    description: Runs automated test suites — coverage gates and regression checks
    role: quality
    sort_order: 35
    # Standby contributors (RFC #7629): when this lane is paused for BUDGET,
    # offer its queue to approved standby contributors whose model
    # configuration clears the lane's floor. Manual dispatch uses this block;
    # auto_dispatch additionally opts the lane into automatic attempts while
    # it is paused. See src/docs/design/standby-contributors.md.
    #
    #   min_model_capability  T1 | T2 | T3, defaulting to T1 — the STRONGEST
    #                         floor, so adopting the block without thinking
    #                         about it gets the safe answer. "unknown" is
    #                         rejected at load: it is the ABSENCE of a tier,
    #                         not a weak one, and a lane floored at unknown is
    #                         a lane anything clears. The floor is READ-ONLY on
    #                         every surface — lowering it is an edit to this
    #                         file, never a control, and nothing Hive renders
    #                         proposes it.
    #   daily_cap_per_contributor
    #                         0 (the default) means NOTHING is dispatched,
    #                         which is what makes the block safe to adopt
    #                         before the dispatch path exists.
    #   enabled: true         REQUIRES a non-empty hub.standby_contributors
    #                         list below, or the hive fails to load: a lane
    #                         that is on with nobody approved is a
    #                         misconfiguration, not a silently inert setting.
    #   auto_dispatch: false  default off; when true, Hive may dispatch from
    #                         this lane automatically while the governor has
    #                         paused it for budget.
    # standby:
    #   enabled: false
    #   auto_dispatch: false
    #   min_model_capability: T1
    #   daily_cap_per_contributor: 0
  architect:
    enabled: false                        # Disabled by default — enable for design work
    backend: claude
    model: claude-sonnet-4-6
    beads_dir: /data/beads/architect
    clear_on_kick: false
    display_name: Architect
    description: Designs RFCs for cross-cutting changes
    sort_order: 40
  supervisor:
    enabled: true
    backend: claude
    model: claude-sonnet-4-6
    beads_dir: /data/beads/supervisor
    clear_on_kick: true
    display_name: Supervisor
    description: Orchestrates all agents — sweeps, enforces cadence, monitors health
    sort_order: 10
    bead_role: supervisor
  outreach:
    enabled: false
    backend: claude
    model: claude-sonnet-4-6
    beads_dir: /data/beads/outreach
    clear_on_kick: false
    display_name: Outreach
    description: Drives CNCF ecosystem engagement — ADOPTERS, ACMM badges, community PRs
    sort_order: 50
    include_repos: false                  # Outreach targets external repos
  sec-check:
    enabled: false
    backend: claude
    model: claude-sonnet-4-6
    beads_dir: /data/beads/sec-check
    clear_on_kick: true
    display_name: Security
    description: Audits dependencies, container images, secrets exposure
    sort_order: 60
  guide:
    enabled: false
    backend: copilot
    model: claude-sonnet-4-6
    beads_dir: /data/beads/guide
    clear_on_kick: true
    display_name: Guide
    description: Documentation and architecture guide — explains, documents, and files doc work
    role: guide
    sort_order: 15
    emoji: "🧭"
    color: "#8e44ad"
    kick_template: guide-advisory.md
    include_repos: true
  strategist:
    enabled: false
    backend: copilot
    model: claude-sonnet-4-6
    beads_dir: /data/beads/strategist
    clear_on_kick: true
    display_name: Strategist
    description: Roadmap alignment, experiments, and cross-agent trend analysis
    role: strategist
    sort_order: 70
    emoji: "🧠"
    color: "#f39c12"
    kick_template: strategist-holdgated.md
    include_repos: false
  brainstorm:
    enabled: false
    backend: copilot
    model: claude-sonnet-4-6
    beads_dir: /data/beads/brainstorm
    clear_on_kick: true
    display_name: Brainstorm
    description: On-demand inception and ideation agent
    role: brainstorm
    sort_order: 5
    emoji: "💡"
    color: "#f39c12"
    kick_template: brainstorm-advisory.md
    include_repos: false
    on_demand: true
    stale_timeout: 7200

# Repeat-failure check (#14550): notice an agent running the same failing shell
# command again and again. Monitor only — it never pauses the agent. Off by
# default; while off Hive collects no command records and adds nothing to an
# agent's environment or home. While on, fresh-bash backends launch with
# BASH_ENV (a Hive-owned recording script) and SHELL=/bin/bash, so bob runs its
# commands in bash instead of dash. Values shown are the defaults.
# repeat_failure:
#   enabled: false
#   threshold: 5          # same command, same result, this many times...
#   window_s: 600         # ...within this many seconds raises a note
#   no_data_after_s: 900  # shell activity but no record this long = "not receiving data"
#   exclude:              # command prefixes that fail by design while waiting
#     - gh pr checks
#     - gh run watch

# Hub — hive-wide contributor settings. Shown here only for the standby keys
# (RFC #7629); the contribute admission filters live on the dashboard's
# Operations tab and are written back here.
# hub:
#   # The APPROVED standby list. Approval is durable and lives here; a relay
#   # declaring standby is volunteering, and volunteering grants nothing. A
#   # login here grants nothing else either — not a trust tier, not a role, not
#   # a credential. An approved standby contributor receives the full task
#   # context for any repository the lane serves, including private ones if you
#   # have enabled that below: approve only people you would give read access to.
#   standby_contributors: [alice, bob]
#
#   # Which contributor model configurations count as which capability tier.
#   # OWNER-AUTHORED, and Hive ships NO defaults: an unmapped configuration is
#   # unknown, and unknown never clears any floor — so a hive that has not
#   # written this mapping reports "0 qualify" rather than admitting a model
#   # nobody assessed. The WHOLE configuration is the key, so the same model at
#   # a different reasoning effort is a different entry; two entries for one
#   # configuration are a load error rather than last-one-wins.
#   standby_model_tiers:
#     - { backend: claude, model: claude-opus-5,  reasoning_effort: high, tier: T1 }
#     - { backend: codex,  model: gpt-5.6-terra,  reasoning_effort: high, tier: T2 }
#
#   # Which classes of WORK ITEM may be offered to standby, and at what tier.
#   # OWNER-AUTHORED and AUTHORITATIVE. Hive's classifier can propose a tier
#   # for an item; a proposal never adds an entry here and never widens one.
#   #
#   # It SHIPS EMPTY, and empty means item-tier matching is not in force at
#   # all: the lane floor decides alone and nothing changes until you opt in.
#   # Once there is one entry, an item matching none of them is unknown, and an
#   # unknown item is not standby-eligible. Matching then needs BOTH bars: a T1
#   # configuration may take a T3 item, a T3 configuration may not take a T1
#   # item. An entry is keyed on (repo, label); omit repo to apply it to every
#   # repository the lane serves, and duplicate tuples are a load error.
#   #
#   # A T3 entry MUST name its signal, because that is what T3 eligibility
#   # means here:
#   #
#   #   An item is T3-eligible only if its correctness is established by an
#   #   automated signal a reviewer can read without reconstructing the change.
#   #
#   # Explicitly NOT T3: anything whose acceptance rests on taste, naming,
#   # prose quality or "does this belong here" — including changelog entries
#   # and doc rewrites, which look small and review expensively.
#   standby_item_tiers:
#     - { repo: my-org/repo-a, label: dependencies, tier: T3, signal: "the lockfile diff plus green CI" }
#     - { repo: my-org/repo-a, label: broken-link,  tier: T3, signal: "the link checker" }
#     - { label: kind/security, tier: T1 }
#
#   # Private repositories are OFF by default. Task context for a private repo
#   # is read access in substance.
#   standby_allow_private_repos: false

# Governor — adaptive scheduler that adjusts agent cadences based on queue depth
governor:
  eval_interval_s: 300                    # Seconds between governor evaluations
  eval_interval_max_s: 1800               # Cap when API budget mode stretches evals
  eval_interval_webhook_s: 900            # Base interval while GitHub webhooks are healthy (see /api/webhook/github)
  webhook_wake_debounce_s: 10             # Quiet period after an invalidating webhook before the early eval cycle
  webhook_wake_min_gap_s: 30              # Minimum gap between webhook-triggered eval cycles
  conserve_interval_multiplier: 2         # Eval interval multiplier in API budget conserve mode
  optional_sweep_every_n_cycles: 1        # Run optional sweeps every Nth normal cycle (1 = every cycle)

  # First-time contributor welcome (see docs/good-first-issue.md#welcoming-first-time-contributors).
  # When a human whose GitHub author_association is FIRST_TIME_CONTRIBUTOR /
  # FIRST_TIMER opens a PR, post one comment (per author per repo, marker
  # <!-- hive:first-timer-welcome -->) inviting them to run their own hive.
  # Needs dashboard.public_url (or a hub-assigned dashboard URL).
  # first_timer_welcome:
  #   enabled: true           # default; false opts out
  #   template_path: ""       # optional text/template file over firsttimer.Vars; must contain {{ .Marker }}

  # Self-merge review gate (#12592). Immediately before the hive merges its
  # own (App-authored) PR, read the swarm review verdict for the head SHA:
  # no-review-bundle / awaiting-review-approval / changes-requested:<perspectives>
  # hold the merge in enforce mode; shadow (default) only records what the gate
  # would have held in the evidence bundle and merges as today. The effective
  # mode is the strictest of this knob, review.require_approval (enforce) and
  # review.shadow (shadow); all three are re-read on every evaluation.
  # review_gate:
  #   mode: shadow            # off | shadow | enforce

  # Kick prompt list caps (#7368). Every issue list and every PR list in a
  # kick is cut at these counts, with an explicit "… and N more" line, so a
  # large backlog cannot balloon the prompt (302 open PRs once produced a
  # 69.5 KiB kick that took ~3 minutes to type into the agent). Zero/absent
  # means the default; there is no "uncapped".
  # kick_limits:
  #   max_issues: 100
  #   max_prs: 50

  # Agent self-healing watchdog (RFC #4665): k8s-style liveness/readiness
  # reconciliation. Observes the tmux pane (not the state echo), restarts dead
  # agents with exponential backoff, escalates crash loops to pause + alert,
  # and publishes Ready/Authenticated/Producing conditions per agent. The whole
  # block is optional — omitted fields use the defaults shown.
  # watchdog:
  #   # mode: how much authority the watchdog has.
  #   #   observe (default) — classify, publish conditions, raise alerts and
  #   #                       record what it WOULD have done. Takes no action.
  #   #   heal            — additionally restart dead agents and pause crash loops.
  #   #   off             — do not run at all.
  #   # Start in observe, read the audit log, then promote to heal.
  #   # HIVE_WATCHDOG_PAUSE=true on the deployment downgrades heal to observe
  #   # fleet-wide without editing any hive's config.
  #   mode: observe
  #   probe_interval_s: 300               # Minimum seconds between sweeps
  #   liveness:
  #     stuck_overlay_after: 10m          # Unanswered modal older than this -> restart
  #     shell_prompt_after: 5m            # Bare shell / silent pane grace before restart
  #   restart:
  #     backoff: [1m, 2m, 4m, 8m, 16m]    # Per-consecutive-failure delay; last entry is the cap
  #     crash_loop_after: 5               # Consecutive failures before pause + alert
  #     healthy_reset: 30m                # Continuous-ready window that clears the counter
  #   readiness:
  #     no_production_for: 6h             # Zero production evidence -> Producing=False + warning
  #                                       # (only when work is actually queued; an
  #                                       #  idle agent with an empty queue is correct)
  #   auth_probe: true                    # Per-provider credential probes (rotation machinery)

  # Optional provider rotation (RFC #5698 phase 1): move agents away from a
  # provider whose measured usage crosses the threshold. This surfaces existing
  # headroom probes only; capacity normalization, placement, pacing, and tier
  # floors remain outside this block.
  # rotation:
  #   enabled: false                      # Opt in; default false
  #   threshold_pct: 85                   # Exhausted at this usage percentage (1-100)
  #   high_volume_cadence_s: 1800         # Agents at/below this cadence avoid subscription providers
  #   providers:
  #     github:
  #       class: subscription             # subscription or metered
  #       backends: [copilot]             # Backend IDs from GET /api/config/backends
  #       monthly_allowance: 1000         # Optional entitlement when APIs report usage only
  #     anthropic:
  #       class: metered
  #       backends: [claude]
  #   agents:
  #     planner: T2                       # Capability tier: T1, T2, or T3
  #     ci-maintainer: T1

  labels:
    automerge: lgtm                     # Label applied by merger queue; default is lgtm
    # exempt: [do-not-merge]             # Labels that hide issues/PRs from agent queues
    stage:                              # Hive-owned stage/NN-* pipeline labels (docs/labels-and-control-signals.md)
      enabled: true                     # One stage label per open issue/PR, plus author/* and the stage/stalled marker
      # stalled:                        # stage/stalled = "no activity"; never applied while the item waits on the hive (#12534)
      #   require_quiet: true           # measure dwell from the last outside activity (push/comment/review/CI); false = from stage entry
      # dwell:                          # Per-stage "stalled" thresholds by slug; 0 = never
      #   review-pending: 1h
      #   needs-author: 24h            # stage/071: human-authored red PR, the author must act
      #   returned-to-contributor: 24h  # stage/072: clanker red PR handed back to its hive
      #   awaiting-merge-admission: 30m  # a stall here = the lane, not the author; the hive comments the last skip reason
      # contributor_nudge:              # stage/072: one @-mention comment per head + relay fix-pr interrupt (#12436)
      #   enabled: true
      #   renudge_interval: 24h         # second (and last) nudge; default = the stage dwell
      # presence_window: 15m            # relay heartbeat this fresh = contributor online → relay interrupt, else comment only
      # contributor_grace_online: 2h    # nudge unanswered this long (online author) → stage/074 adoption
      # contributor_grace_offline: 15m  # same for offline / external authors (comment-only nudge)
      # adoption:                       # stage/074-adopted-by-hive: repair a still-red contributor PR
      #   enabled: true                 # default true; false leaves the PR in stage/072
      #   in_place: true                # default true; push to the original branch when GitHub permits
      #                                 # otherwise supersede with an App PR retaining the author's commits
      #   strict_attribution: true      # default true; changed in-place heads keep ownership only when
      #                                 # GitHub links their commits to the App bot (fail closed)
      #   after_offline: 15m            # default 15m; registered relay offline, measured from the later
      #                                 # of its last heartbeat and the first stage/072 nudge
      #   after_unregistered: 15m       # default 15m; no contributor profile, wait after the nudge with no new head
      #   supersede:
      #     close_first: true           # default true; close the original (hive/superseded, one note naming the
      #                                 # copy) in the pass that opens the copy; reopened if the copy fails.
      #                                 # false: original stays stage/074 and closes when the copy merges

  # Optional: read actionable work from Linear instead of GitHub Issues.
  # Secrets should come from env interpolation, not literal values.
  # work_source:
  #   type: linear
  #   linear:
  #     api_key: ${LINEAR_API_KEY}
  #     hold_labels: [hold]              # additive; GitHub's hold defaults still apply
  #     teams:
  #       - key: ENG
  #         repo: your-org/default-repo
  #         states: [Todo, In Progress]
  #         cycles: current              # optional; only issues in the active cycle
  #         projects:                    # optional; when present, only these projects enumerate
  #           - name: Platform
  #             repo: your-org/platform
  #           - name: Mobile             # no repo => team.repo fallback

  # Optional: read actionable work from a GitHub Projects v2 board instead of
  # bare repo issues. Uses the same GitHub token as the rest of the hive
  # (needs the read:project scope). See docs/work-sources.md.
  # work_source:
  #   type: github_projects
  #   github_projects:
  #     project_number: 7                # required — the number in the project URL
  #     org: your-org                    # optional — defaults to project.org
  #     states: [Todo, In Progress]      # optional — Status field values; empty = all
  #     priority_field: Priority         # optional — single-select priority field name
  #     iteration_field: Sprint          # optional — only current-iteration items when set
  #     default_repo: your-org/repo      # optional — fallback when an item's repo is unknown

  # Optional: read actionable work from Jira Cloud instead of GitHub Issues.
  # Read-only. Secrets should come from env interpolation, not literal values.
  # See docs/work-sources.md.
  # work_source:
  #   type: jira
  #   jira:
  #     base_url: https://your-org.atlassian.net   # required
  #     email: bot@your-org.com                     # required — Atlassian account email
  #     api_token: ${JIRA_API_TOKEN}                 # required — Atlassian API token, not password
  #     project_keys: [ENG, OPS]                      # used to build the default JQL
  #     # jql: "project in (ENG) AND statusCategory != Done"  # optional full override
  #     repo: your-org/default-repo                   # required — repo agents clone for these issues
  #     hold_labels: [hold, blocked]                   # optional — Jira labels that gate an issue

  modes:
    surge:
      threshold: 20                       # Queue depth >= 20 triggers SURGE
      scanner: 15m
      ci-maintainer: pause                # "pause" means don't kick this agent
      quality: pause                      # coverage isn't urgent during fire-fighting
      architect: pause
      guide: pause
      strategist: pause
      # brainstorm is on_demand and is not kicked by the governor
    busy:
      threshold: 10
      scanner: 15m
      ci-maintainer: 1h
      quality: 2h
      architect: pause
      guide: 4h
      strategist: pause
    quiet:
      threshold: 2
      scanner: 15m
      ci-maintainer: 45m
      quality: 45m
      architect: pause
      guide: 4h
      strategist: 4h
    idle:
      threshold: 0
      scanner: 15m
      ci-maintainer: 15m
      quality: 30m                        # most active when nothing else is happening
      architect: 30m
      guide: 4h
      strategist: 4h

  # Time-of-day cadences are available anywhere an interval appears above.
  # Each entry must use exactly one of: interval string (e.g. 4h/pause),
  # times+tz, or cron+tz. Do not mix interval, times, and cron in one value.
  # examples:
  #   guide:
  #     times: ["09:00", "17:00"]        # wall-clock local times
  #     days: [mon, tue, wed, thu, fri]   # optional; omit for every day
  #     tz: America/New_York              # required for times/cron
  #   strategist:
  #     cron: "30 8 * * mon-fri"          # five-field cron expression
  #     tz: UTC

  # Trajectory review lane — periodic second-model review of running agents.
  # Enabled by default; it no-ops until endpoint+model resolve here or via litellm.
  trajectory:
    enabled: true
    # endpoint: https://litellm.example.com
    # api_key_env: HIVE_LITELLM_API_KEY
    # api_key_file: /secrets/litellm_api_key
    # interval_s: 300
    # model: gpt-4o-mini
    # transcript_lines: 200
    # on_divergence: pause               # pause | alert
    # exempt_agents: [outreach]

  # LiteLLM inference backend (optional) — route agents through an
  # OpenAI-compatible LiteLLM proxy. Agents using backend "litellm" launch
  # the claude CLI in bare mode and reach the endpoint through the hive's
  # inference translator (the MITM proxy stays in the path).
  # SECURITY: never put the API key VALUE here — hive.yaml is rewritten by
  # the dashboard with env vars expanded. Store only the env var NAME or a
  # key file path; the key is resolved at use time.
  # litellm:
  #   endpoint: https://litellm.example.com   # base URL (HIVE_LITELLM_ENDPOINT overrides)
  #   api_key_env: HIVE_LITELLM_API_KEY       # env var NAME holding the key (default)
  #   api_key_file: /secrets/litellm_api_key  # or a mounted key file (default path)
  #   default_model: gpt-4o                   # model used when an agent has none selected
  #   ca_bundle: /secrets/litellm-ca.pem      # optional PEM for a private CA
  #   local_proxy: false                      # run the bundled litellm binary locally
  #                                           # (config at /data/litellm/config.yaml)

  # Named Model Gateways (optional) — configure one or more OpenAI-compatible
  # gateways at once (e.g. OpenRouter for public models plus a private LiteLLM
  # proxy for internal ones); each agent picks one by naming it as its
  # backend. When this list is empty, a single implicit gateway named
  # "litellm" is synthesized from the litellm block above, so existing hives
  # keep working with zero config change.
  # gateways:
  #   - name: openrouter                        # unique gateway id; agents set backend: <name>
  #     kind: openrouter                        # openrouter | litellm | vllm | llm-d | watsonx | custom
  #     endpoint: https://openrouter.ai/api/v1  # OpenAI-compatible base URL
  #     api_key_env: OPENROUTER_API_KEY         # env var NAME holding the key (or use api_key_file)
  #     default_model: deepseek/deepseek-chat   # model used when an agent has none selected
  #     key_name: openrouter-prod-key           # optional: human LABEL for the configured key,
  #                                             # shown in the dashboard as "Using key: <name>"
  #                                             # (or "(unnamed)"); safe-to-show, NOT a secret

  # IBM bobshell ("bob") backend credentials. REQUIRED for agents with
  # backend: bob — bob's default IBMid/W3ID auth opens a browser and waits on a
  # localhost callback, which no pod can satisfy, so it fails after a 3-minute
  # timeout. With a key, hive launches bob with --auth-method api-key and it
  # authenticates headlessly (interactive tmux use still works). If Bob returns
  # HTTP 401 / "API Key verification failed: Invalid or expired API Key", Hive
  # reports the agents as needing login/credential refresh instead of restart.
  # SECURITY: store only the env var NAME or a key file path, never the value.
  # Both defaults below are consulted automatically, so if you mount the key at
  # /secrets/bob_api_key or set HIVE_BOB_API_KEY, this block can stay commented.
  # bob:
  #   api_key_env: HIVE_BOB_API_KEY       # env var NAME holding the key (default)
  #   api_key_file: /secrets/bob_api_key  # or a mounted key file (default path)
  #   key_name: bob-shared-key            # optional: human LABEL for the configured key,
  #                                       # shown in the dashboard as "Using key: <name>"
  #                                       # (or "(unnamed)"); safe-to-show, NOT a secret

# Retro lane — post-completion analysis. Disabled by default;
# when enabled it scans recently completed beads with closed/merged PR metadata
# and files rule-based findings as local advisory beads (no GitHub posts).
# Optional analysis_model enables bounded LLM root-cause/improvement analysis
# via governor.litellm and feeds generalized lessons into the knowledge graph.
# retro:
#   enabled: false
#   scan_interval_s: 3600
#   max_fix_attempts: 3
#   max_kicks: 5
#   long_stall_days: 7
#   recent_closed_window_s: 604800
#   analysis_model: ""   # empty disables all LLM calls (default)
#   lesson_confidence_step: 0.05   # confidence added per recorded repeat of a retro lesson
#   lesson_confidence_cap: 0.9     # repeats never raise a lesson above this

# Planning intelligence — the `plan`/`epic` issue-label trigger that auto-mints
# an epic bead and requests architect decomposition (see docs/planning-intelligence.md).
# Only gates the label trigger; the dashboard's "Plan this issue" button is always
# available regardless of this block. OFF by default: the label path pipes a raw
# issue body into the architect's kick prompt with no per-kick review, so this
# must be explicitly opted into. Even when true, it is a no-op below ACMM L5 —
# the decomposing architect only has a cadence at L5+.
# planning:
#   plan_from_label: false

# Optional formal-verification capability for the quality lane. OFF by default
# and effective only at ACMM L5/L6. When enabled, quality may author
# Spin/Promela models for protocol-shaped code under formal/<subsystem>/, add a
# path-gated reporting-only CI job, and maintain one deduplicated issue per
# violated property. See docs/formal-verification.md for the artifact contract.
# quality:
#   formal: false

# Long-running runs triage (#8450). OFF by default. When enabled, the
# scheduler classifies each actionable issue as direct-fix, spec-run, or
# needs-clarification before dispatch. Spec verdicts require the Spektacular
# runner too, because that runner advances spec/plan stage leases.
# runs:
#   triage:
#     enabled: false
#     spec_labels: [kind/feature, Epic, architecture discussion]
#     fix_labels: [kind/bug, good first issue]
#     min_body_chars: 80
#     clarify_comment: true
#     clarity_gate:          # park unclear human-filed issues with needs-spec and ask the author (#13577)
#       enabled: false
#       threshold: 60        # clarity score 0-100 an issue needs to stay in the agent queue
#   spektacular:
#     enabled: false
#     binary: spektacular
#     poll_interval_s: 30
#     interview: human # human (default) pauses for dashboard answers; auto preserves headless self-answering.
#     recheck:
#       enabled: false
#       default_interval: 168h
#       max_delta_tasks: 50
#       discovery:
#         enabled: false
#         timeout: 30s
#         max_total_items: 100
#         sources:
#           - {kind: upstream_release, name: kubernetes, url_or_repo: kubernetes/kubernetes, max_items: 10}
#           - {kind: repo_activity, name: competitor-runtime, url_or_repo: example/runtime, allow_prerelease: true}
#           - {kind: standards_feed, name: ietf-http, url_or_repo: https://www.ietf.org/archive/id/atom.xml}
#           - {kind: landscape, name: project-landscape, max_items: 20}
#       # Exact-document sources are read only through discovery_proxy (no direct
#       # or NO_PROXY fallback) and must be hosts in egress_allowlist.
#       discovery_proxy: http://relay:18443
#       egress_allowlist: [api.github.com]
#       sources:
#         - {name: upstream-release-doc, kind: release, url: https://api.github.com/repos/jumppad-labs/spektacular/releases/latest}
#   checkpoints:
#     spec: true        # false records finalized spec checkpoints as auto-approved by actor "auto".
#     plan: true        # false auto-approves imported plans and records config_source in audit/timeline history.
#     implement: true   # false may auto-approve only at ACMM L5+; lower ACMM levels keep this checkpoint blocking.
#   wait_timeout_seconds: 3600
#   wait_severity: decision
#   max_stage_retries: 2 # generations (agent launches) one hub-executed stage may spend before a decision escalation
#   max_worktrees: 8

# Report-only external-execution binding pilot (#8361; Gate 0 decision in
# docs/design/external-workflow-admission.md). OFF by default. `enabled: true`
# with no mode runs in shadow: admissions are persisted on the task lease and
# observed, but no external run is started and nothing external is mutated.
# `mode: report-only` dispatches one bounded Flue generation workflow to the
# runtime at `endpoint`, pinned to `workflow_version`; the engine never receives
# a repository write credential, a dashboard token, or a publication tool. The
# adapter is compiled in only with the `extwork_flue` build tag; without it the
# toggle is inert and the Features panel says so.
# runs:
#   external:
#     flue:
#       enabled: false
#       mode: shadow                  # or report-only
#       endpoint: http://127.0.0.1:8585
#       workflow_version: flue-fixture/1.0.0

# Private-spoke Claude Managed Agents hosted-execution prototype (#14124).
# OFF by default. The adapter is linked only with the
# `extwork_claude_managed_agents` build tag; enabled with no mode is shadow,
# and only explicit report-only dispatches. The environment must be
# self_hosted behind forced egress or proxy-only, direct GitHub writes are
# refused, and the durable ledger caps the spoke at USD 25 per UTC day.
# API key settings below are references, never key values.
# runs:
#   external:
#     claude_managed_agents:
#       enabled: false
#       mode: shadow
#       endpoint: https://api.anthropic.com
#       workflow_version: claude-managed/2026-04-01
#       agent_id: agt_private
#       agent_version: 1
#       toolset_version: hive-tools/1
#       environment_id: env_private
#       environment_type: self_hosted
#       network_policy: forced-egress
#       api_key_env: ANTHROPIC_API_KEY
#       model: claude-sonnet-4-6
#       state_dir: /data/extwork/claude-managed-agents
#       daily_budget_cents: 2500
#       github_write_path: none

# CEL-based agent triggers — declarative rules that kick an agent directly off
# a normalized source-control event (issue opened, PR opened, a label applied,
# a comment posted), evaluated with CEL against the `event` variable. This is
# additive: it runs alongside the existing label/governor triggering above, not
# instead of it, and an absent/empty list is byte-identical to today's behavior.
# The evaluator fails closed — a malformed rule is rejected at config load, and
# a runtime evaluation error is treated as "no match", never a crash.
# See docs/cel-triggers.md for the full `event.*` field reference and worked
# examples.
# triggers:
#   - name: bug-triage
#     expr: event.kind == "issue.opened" && hasLabel(event.labels, "bug")
#     agent: triager
#     priority: 10
#   - name: ready-pr-review
#     expr: event.kind == "pr.opened" && !event.is_draft && event.base_branch == "main"
#     agent: reviewer

# State-triggered hooks — optional vetted actions on durable hive transitions.
# Default is absent/empty (no hooks fire). These examples hand run stages to
# their next owner without adding a scheduler; rate limits still apply.
# hooks:
#   - name: run-plan-owner
#     on: stage_completed
#     action: kick
#     when: t.stage_to == "plan"
#     params:
#       agent: architect
#       reason: plan stage is ready
#   - name: run-implement-owner
#     on: stage_completed
#     action: kick
#     when: t.stage_to == "implement"
#     params:
#       agent: quality
#       reason: implement stage is ready

# Review swarm merge gate — optional structured multi-perspective PR review.
# Default is false to preserve existing merge eligibility behavior; when true,
# merge-eligible.json requires an aggregate approve in review-verdicts.json.
# review:
#   require_approval: false
#   shadow: false       # evaluate the approval gate without enforcing it; records
#                       # shadow.review_gate.would_have_held on the evidence bundle (#12104)
#   fan_out: false
#   max_parallel_reviews: 5
#   reviewer_agents: [] # optional explicit list; otherwise agents with review role/keywords are used
#   reviewers:
#     autoscale:        # size the reviewer lane to its backlog (#14685); off by default
#       enabled: false
#       agent: ""       # base reviewer to scale; default: first role:reviewer agent, else reviewer_agents[0]
#       min: 1          # floor of active replicas (the base agent is never retired)
#       max: 4          # ceiling; capped at the agents.<name>.replicas limit (5)
#       target_backlog_per_reviewer: 2 # PRs waiting per reviewer before the lane is "behind"
#       scale_up_cycles: 2   # consecutive behind cycles before adding a reviewer
#       scale_down_cycles: 5 # consecutive idle cycles before draining the top replica
#       cooldown: 5m         # minimum gap between scaling actions
#       cpu_per_reviewer: 1.0     # cgroup CPU (cores) reserved per added reviewer
#       mem_per_reviewer_mb: 2048 # cgroup memory (MiB) reserved per added reviewer
#   combined_perspectives: true # RECOMMENDED (#12126): one session + one comment covering every
#                               # perspective; shared review boilerplate is sent once instead of once
#                               # per perspective. Verdicts stay per-perspective. Default false.
#   fixer_agent: ""     # optional override; defaults to the PR lane, then scanner
#   pending_ttl: 45m    # re-dispatch a review whose kick posted no verdict after this long
#                       # (Go duration; default 45m; negative disables expiry)
#   pending_fix_ttl: 2h # dispatch the next bounded fix attempt when a fixer turn has
#                       # pushed no new head after this long (Go duration; default 2h;
#                       # negative disables expiry)
#   max_redispatch: 3   # expiries per PR head before the planner stops re-kicking and
#                       # records a requires_human hold (review-dispatch-exhausted)
#   out_of_scope_backlog_disabled: false # true opts out of review-filed backlog issues
#   max_out_of_scope_backlog_issues: 3   # cap per PR; 0 uses the default
#   severity:                 # blocking line (#11088); Settings -> Features -> Review Gate
#     block_at: P2            # P1 (ship fast: P0-P1 block) | P2 (strict: P0-P2) | P3 (everything); unset = unchanged
#     comment_below: true     # post findings below the line as non-blocking comments (default true)
#     backlog_below: true     # file findings below the line to review.backlog (default true)
#   backlog:
#     destination: github_issue # github_issue | github_project | linear | jira (last three need that governor.work_source.type)
#     project_column_id: ""     # required for github_project: Projects v2 status option id
#     linear_state: ""          # linear: workflow state; blank = team default
#     jira_status: ""           # jira: status; blank = project initial status
#     labels: [origin/review]   # provenance label; legacy from-review is mapped to it
#     max_per_pr_per_day: 10    # 0/unset = 10

# Compliance control mapping (#11078) — optional. Selects the framework
# profiles (src/pkg/compliance/profiles) whose controls GET /api/compliance/status
# evaluates against this config. Read-only: each control points at an existing
# setting. Not a certification — see src/docs/compliance.md. Default: none.
# compliance:
#   frameworks: [soc2-type2]   # also: fedramp-moderate, iso27001-annex-a
#   posture_checks:
#     interval: 1h        # 5m..168h; 0/unset = 1h. Posture checks (#11079) run
#                         # on this cadence; GET /api/compliance/posture.
#     window_days: 30     # merged-PR look-back, 1..90; 0/unset = 30
#     history_days: 365   # posture-history retention, 30..1095; 0/unset = 365

# External review-bot threads on hive-authored PRs (#7360) — optional. When a
# bot named here leaves inline review threads on a PR the hive opened, the
# governor lists the unresolved ones in /var/run/hive-metrics/review-threads.json,
# the agent that opened the PR gets them as fix-before-new work on its next
# kick, and it replies in-thread / resolves them through the review relay
# (hive-review --thread / --resolve-thread). The watcher refuses to touch any
# thread a human opened. The same key may live in hive-project.yaml instead
# (hive.yaml wins when both name a login). Absent or empty logins = off.
# Logins match case-insensitively; either spelling with or without [bot] works.
# classification:
#   review_bots:
#     logins:
#       - "chatgpt-codex-connector[bot]"
#       - "Copilot"
#     min_priority: P1            # optional: P0/P1 and unknown badges only; unset falls back to review.severity.block_at
#     max_attempts_per_thread: 1   # hive replies per thread before a human takes over
#     resolve_after_fix: true      # false: reply but leave the thread open

# GitHub authentication — use ONE of these methods
github:
  # Option 1: Personal access token (simplest)
  token: ${HIVE_GITHUB_TOKEN}
  # Reuse per-PR detail GETs while list head.sha/updated_at still match.
  pr_detail_ttl_s: 1800
  # Batch open PR detail and CI rollups with GraphQL during scans (default true).
  graphql_pr_batch: true
  graphql_pr_batch_page_size: 50

  # Option 2: GitHub App (recommended for production)
  # app_id: 12345
  # installation_id: 67890
  # key_file: /secrets/gh-app-key.pem
  # mentions:
  #   enabled: true
  # actions:
  #   enabled: false
  #   source_label: action
  #   allowed_commands: [status, review]
  #   allow_apply: false
  #   identity_map:
  #     octo-ci-bot: alice
  #   oidc:
  #     enabled: false
  #     audience: hive-prod
  # Opt in on shared-UID deployments (e.g. OpenShift restricted-v2).
  # Gives agents read-only App caches; agents can read each other's caches.
  # Writes still use the relays. Requires App auth; default false. Restart to apply.
  # shared_uid_read_token: true
  # agent_reserve_floor: 400              # Keep this many core requests reserved for daemon scan/merge paths.

  # Shared GitHub App/PAT core API budget floors. When remaining core quota
  # drops below reserve, Hive skips optional sweeps; below critical it sheds
  # more work and stretches the governor eval interval further.
  api_reserve: 800
  api_critical: 250

# Optional: OIDC token mint — issues short-lived scoped JWTs alongside the
# GitHub App token, for in-process agent-credential consumers. Disabled by
# default (absent block == byte-identical to enabled: false). SECURITY-
# SENSITIVE — read docs/token-mint.md and docs/adr/0007-token-mint.md before
# enabling: the signing key at key_path must never be readable outside the
# hive process, and there is no rotation automation.
# mint:
#   enabled: true
#   key_path: /data/mint-signing-key.pem   # auto-generated (0600) if absent; must be on persistent storage
#   issuer: https://your-hive.example.com  # iss claim; treat as immutable once anything trusts it
#   max_ttl_seconds: 900                    # default 900 (15m); silently clamped to a 3600s (1h) hard cap

# Notifications — configure one or more channels. See docs/notifications.md.
notifications:
  ntfy:
    server: https://ntfy.sh
    topic: my-hive-alerts
  # slack:
  #   webhook: ${SLACK_WEBHOOK_URL}
  # discord:
  #   webhook: ${DISCORD_WEBHOOK_URL}
  #   # Optional Discord bot integration; separate from webhook notifications.
  #   bot_token: ${DISCORD_BOT_TOKEN}
  #   channel_id: "1234567890"

# OpenTelemetry trace export (optional, off by default). When enabled, Hive
# exports governor eval cycles, agent kicks, and recorded lifecycle
# events as OTLP/HTTP spans with GenAI semantic convention attributes for model/backend usage.
# otel:
#   enabled: false
#   endpoint: https://otel-collector.example.com/v1/traces
#   service_name: hive
#   insecure: false
#   headers:
#     authorization: Bearer ${OTEL_EXPORTER_TOKEN}

# Dashboard — embedded web UI with SSE live updates
# Security headers (CSP, X-Frame-Options, etc.) are always active.
# Set auth_token to require Bearer auth on /api/* endpoints (except /api/health).
dashboard:
  port: 3001
  # Exact HTTPS origins allowed to embed /snapshot; empty denies all framing.
  # snapshot_frame_ancestors:
  #   - https://status.example.com
  auth_token: ${HIVE_DASHBOARD_TOKEN}     # Optional — omit to allow unauthenticated access
  # authorized_users: [owner, reviewer:read, maintainer:read-write]
  # hub_proxied: false                    # True when trusted hub nginx injects identity headers
  # agent_poll_interval_s: 5
  # stage_tracker:
  #   cache_ttl_s: 300                    # Hive activity monitor payload cache; default = governor.eval_interval_s
  # theme: hive                         # Built-in theme id from /api/themes (for example hive, hive-dark, hive-light, star-wars, dungeons-and-dragons, star-trek, cyberpunk, terminal, solarized-dark, nord); or custom
  # theme_overrides:
  #   tokens: { "--accent": "#e0a33a" } # CSS variables from the dashboard :root allow-list
  #   background:
  #     image: https://example.org/bg.svg # https or data: URI (inlined data capped at 256 KiB)
  #     opacity: 0.08
  #     attachment: fixed
  #   custom_css: |                       # owner-only; capped at 32 KiB and sanitized
  #     .panel { border-radius: 2px; }

# Hub/spoke metadata — normally written by hosted-hive provisioning.
# Standalone operators usually leave this disabled.
# hub:
#   enabled: false
#   url: https://hive-hub.example.com
#   cluster_id: my-cluster
#   dashboard_url: https://hive.example.com
#   snapshot_url: https://hive.example.com/snapshot
#   is_public: false
#   auto_snapshot: true
#   auto_upgrade: true
#   upgrade_drain_timeout_s: 2700  # self-upgrade waits up to this long for in-flight agent kicks (new kicks withheld); 0/unset = 45 min, negative disables; a kick unsettled past its agent's continuous_turn_ceiling (default 45m) is treated as wedged and does not hold the drain
#   task_status_push: true  # HIVE_HUB_TASK_STATUS_PUSH overrides; false stops only the separate task-status loop (restart required)
#   contribute_labels_mode: deny
#   contribute_deny_labels: [hold, wontfix]
#   contribute_repo_filters:
#     owner/repo:
#       labels_mode: allow
#       deny_labels: [good-first-issue]
#       titles_mode: deny
#       deny_titles: ["WIP*"]
#       authors_mode: deny
#       deny_authors: [dependabot[bot]]
#   contribute_needs_decision_label: needs-decision  # label relays apply for no_work_needed — decision: ...; empty disables
#   # Relay audit level this hive ASKS contributors to share (lifecycle |
#   # commands | reasoning), shown on auth_ok and /contribute. A request only:
#   # nothing is uploaded without the contributor's `--share-audit` opt-in, and
#   # admission never depends on it. Empty (default) requests nothing.
#   contribute_audit_share_request: ""
#   # Contributor queue: "already done" no_work_needed verdicts are commented
#   # and labeled so the issue stays out of re-offer until a maintainer removes
#   # the label. Verified merged-PR evidence runs the normal completed close path.
#   contribute_already_done_label: hive/already-done
#   contribute_close_already_done: false  # deprecated compatibility key
#   contribute_already_done_hold_days: 30
#
# hive_id: my-hive
# acmm_level: 2

# Variable resolvers — env-only interpolation is the default. Script/http and
# GitHub prompt sources are trusted-seed features and are denied unless enabled.
# variables:
#   security:
#     allow_exec: false
#     allow_http: false
#     http_allowlist: []
#     allow_github_prompt: false
#     github_prompt_allowlist: []
#   defs:
#     EXAMPLE_TOKEN:
#       type: env
#       env: EXAMPLE_TOKEN
#       scope: config

# Experiment Lab (Nous) — repo-only controlled experiment framework for
# your repositories' code (tests, CI config, automation scripts).
# Formerly the Strategy Lab. The dashboard section is hidden by default; show
# it with `dashboard.experiment_lab: true` (the old `dashboard.strategy_lab`
# key is a deprecated alias for one release).
# There is intentionally NO `nous:` block here: Nous has no YAML config
# surface. It is configured entirely at runtime through the dashboard
# (Experiment Lab panel, ACMM level 4+) or the /api/nous/* endpoints.
# See docs/experiment-lab.md for the experiment lifecycle, trust modes,
# fast-fail bounds, schedule, and gate-decision flow.

# Hive-self experiments — background-only scheduler for experiments on Hive
# itself (not the Experiment Lab above; never shown there and never touches
# governor config). Default off. The tick runs only with enabled: true AND
# mode: background; it judges each unresolved experiment in the local ledger
# and durably reverts fast-failed or finished treatments.
# Experiments are registered by the hub/relay, which is not yet wired, so the
# ledger (/data/nous/self-experiments.json) stays empty until then.
# self_experiments:
#   scheduler:
#     enabled: false
#     mode: background   # the only mode that runs
#     interval_s: 300

# ForgeState — per-repo GitHub issue/PR state cache (#13373). Default off.
# Three writers keep it current: a slow ETag-conditional full reconcile
# (authoritative; on failure the last good snapshot is kept and marked
# stale instead of going empty), webhook patches that re-fetch only the
# named item, and write-through of the hive's own label/comment/merge/close/
# claim mutations. Irreversible actions re-read items older than
# freshness_bound_s and never act on a stale snapshot. With it enabled the
# governor work source lists each repo's open issues/PRs from the cache
# (#13375): the store's reconcile is the only full list, webhook wakes
# decide from the cached snapshot, and the first decision pass waits for
# the first successful reconcile of every repo.
# forgestate:
#   enabled: false
#   reconcile_interval_s: 900   # full list per repo; shortened while drift is high
#   freshness_bound_s: 60       # max item age before merge/close/claim/kick re-reads
#   drift_threshold: 0.05       # fraction of items a reconcile may find wrong in the cache
#   search_budget: 20           # GitHub search calls per minute (GitHub allows 30)

# Knowledge — 4-layer wiki system powered by llm-wiki (geronimo-iia/llm-wiki)
# Facts are primed into agent kicks automatically — agents never query the wiki.
# Personal layer stays on your machine; project layer lives in the repo.
knowledge:
  enabled: false                             # Set to true to activate knowledge priming
  engine: llm-wiki
  # contributor_export_max_facts: 80        # Contributor registration-token downloads of
                                             # /api/knowledge/export are startup summaries,
                                             # not full backups. Spokes read the matching
                                             # HIVE_CONTRIBUTOR_KNOWLEDGE_EXPORT_MAX_FACTS env var.
  # contributor_context_token_budget: 12000  # Contributor CLIs with small/ancestor-scanned startup
                                             # contexts (currently pi) should inline only this
                                             # approximate token count and fetch the full export
                                             # on demand. Relay containers read the matching
                                             # HIVE_CONTRIBUTOR_KNOWLEDGE_TOKEN_BUDGET env var.
  layers:
    - type: personal
      path: ~/.hive/wiki                     # Private, local-only, highest precedence
      shared: false
    - type: project
      path: .hive/wiki                       # Same visibility as the repo
      shared: true
    # - type: org
    #   url: https://wiki.your-org.dev/mcp   # Team-scoped, hosted llm-wiki instance
    #   shared: true
    # - type: community
    #   url: https://wiki.hive.dev/mcp       # Public, read-only
    #   shared: true
  curator:
    # enabled: true                          # OPT-IN. Absent or false = scheduled
                                             # auto-promotion never runs, even with a
                                             # schedule set below. Auto-promotion copies
                                             # facts into a higher layer with NO human
                                             # review, so it is off unless you ask for it.
    schedule: daily                          # Cadence for the promotion sweep once
                                             # enabled: true. Accepts daily or hourly.
                                             # Ignored entirely while disabled.
    extract_from:
      - pr_comments
      - ci_failures
      - review_comments
    auto_promote_threshold: 0.9              # Confidence to auto-promote project→org
    # promote_from: project                  # Source layer (default: project)
    # promote_to: org                        # Target layer (default: org)
  # publish:                                 # One-way mirror of curator-promoted facts
  #   connector: team-docs                   # A knowledge.connectors entry that can publish (sharepoint)
  #   layers: [org, project]                 # project | org | community — personal is never published
  #   root: Hive/Knowledge                   # Folder/page to publish under
  #   include_types: [decision, gotcha]      # Optional; empty = every type
  #   dry_run: false                         # true = compute + audit only, write nothing
  #   propose_via: https://github.com/your-org/knowledge-base   # Shown in each page footer
  git_sources:                               # Remote git repos indexed as knowledge
    # - name: dakota-skills                  # Display name for this source
    #   url: https://github.com/projectbluefin/dakota
    #   branch: main                         # Default: main
    #   subpath: docs/skills                 # Only index this subdirectory
    #   layer: project                       # Which layer: personal, project, org, community
    # - name: k8s-patterns
    #   url: https://github.com/your-org/knowledge-base
    #   subpath: patterns
    #   layer: org
  vaults:                                    # Local Obsidian vaults auto-connected at boot
    # - name: team-notes                     # Display name (also the vault name in the API)
    #   path: /data/vaults/team-notes        # git-inited and seeded on first boot
    #   auto_index: true                     # Parsed but unactioned — indexing always
    #                                        # happens on connect regardless of this value
    #   git_sync: true                       # Pull + reindex every 60s (Obsidian Git)
  documents:                                 # PDFs/URLs/files imported as knowledge at boot
    # - name: style-guide
    #   url: https://example.com/style-guide.pdf   # Or file_path: /data/docs/guide.pdf
    #   layer: project                       # personal, project, org, or community
  connectors:                                # Scheduled external sources → vault facts
                                             # (docs/knowledge-curator.md, docs/knowledge-connectors.md).
                                             # Secrets only via auth.env / auth.file, never inline.
    # - name: repo-knowledge                 # Repository-carried knowledge: .hive/wiki/*.md
    #   type: repo-wiki                      # from each repo's reviewed history
    #   layer: project
    #   scope:
    #     repos: your-org/app, your-org/docs
    #     branch: main                       # Default: main
    #     dir: .hive/wiki                    # Default: .hive/wiki
    # - name: eng-wiki                       # Unique: lowercase letters, digits, dashes
    #   type: confluence                     # Cloud + Data Center
    #   layer: org
    #   interval: 1h                         # Default 15m, minimum 1m
    #   scope:
    #     base_url: https://acme.atlassian.net/wiki
    #     email: hive-bot@acme.com           # Cloud only (Basic auth with the API token)
    #     spaces: ENG, OPS                   # And/or root_page_ids: 12345, 67890
    #   auth:
    #     env: CONFLUENCE_API_TOKEN          # Data Center: a personal access token
    # - name: product-notes
    #   type: notion                         # Share pages with the integration first
    #   layer: project
    #   scope:
    #     root_page_ids: 1a2b3c4d5e6f47a8b9c0d1e2f3a4b5c6   # Optional; default: all shared pages
    #   auth:
    #     file: /var/run/secrets/notion/token
  bead_synthesizer:                          # Bead→wiki synthesis. ON BY DEFAULT — runs
                                             # hourly even when knowledge.enabled is false.
    # enabled: false                         # The only way to turn it off
    schedule: hourly                         # hourly (default) or daily; anything else
                                             # falls back to hourly
    min_confidence: 0.0                      # Drop classified facts below this confidence
                                             # (heuristic classifier emits 0.5–0.8)
    target_layer: personal                   # Layer facts are primed at (default: personal)
    max_facts_per_cycle: 0                   # 0 = unlimited
    max_api_calls_per_cycle: 40              # Cap on charged GitHub PR GETs per cycle (default 40);
                                             # HIVE_BEAD_SYNTH_MAX_API_CALLS overrides. 304s are not charged.
    vault_path: /data/vaults/bead-synth-wiki # Auto-created and auto-connected
    retention_policy:                        # Bead lifecycle management (always active)
      max_beads: 5000                        # Archive down to 80% of this when exceeded
      archive_after_synth_days: 7            # Archive synthesized beads after N days
      high_priority_retain_days: 30          # P0/P1 beads kept at least this long
      preserve_with_deps: true               # Never archive beads with open dependents.
                                             # Defaults to true when retention_policy is
                                             # ABSENT, but false when the block is present
                                             # without this key — set it explicitly.
    # publish:                               # Publish facts to a repo via PR (OFF by default)
    #   enabled: false                       # The block does nothing until true
    #   repo: ""                             # owner/name; empty = project.primary_repo
    #   path: docs/knowledge/                # Or .hive/knowledge/; relative, no ".."
    #   base_branch: ""                      # Empty = the repo's default branch
    #   mode: pr                             # pr (default) | commit. ACMM L<=4 hives publish via
    #                                        # PR only; commit is not honored and opens a PR
    #   cadence: per_run                     # per_run (default) | daily
  # code_maps:                               # Generated repository code maps (#11106).
  #   enabled: true                          # OPT-IN; absent or false = never generated
  #   schedule: hourly                       # HEAD check cadence: hourly (default) or daily
  #   vault_path: /data/vaults/code-maps     # Auto-created and auto-connected
  #   layer: project                         # Layer recorded on each map (default project)
  #   max_bytes: 16384                       # Hard cap on each rendered map
  #   repos:
  #     - name: hivecommons/hive             # Becomes the repo:<name> scope tag
  #       path: /workspace/hive              # Existing checkout, or:
  #     # url: https://github.com/org/repo   # cloned (https only, like git_sources)
  #     # branch: main
  primer:
    max_facts: 25                            # Max facts injected per agent kick
    priority:                                # Fact types, highest priority first
      - regression
      - gotcha
      - test_scaffold
      - pattern
      - decision
    merge_strategy: precedence               # personal > project > org > community

# Write-back containment — what the platform may say on GitHub unasked.
# Applies to comments/labels/reviews on PRs and issues hive did not open and
# nobody opted in on (platform sweeps: sentinel, hold-gate notices, stage
# labels, supersession, duplicate-fix, reporter-trust …). Never gates hive's
# own PRs/issues, /hive command replies or dashboard-triggered work.
# See docs/acmm-policy-matrix.md "What hive will say on GitHub at each level".
# writeback:
#   unsolicited:
#     min_level: 5            # raises every per-kind floor below; never lowers one
#     require_labels: true    # foreign PRs also need review.require_labels (fallback hive-review)
#     backfill: false         # never touch items created before hive first saw / could write to the repo
#   per_repo:
#     torch-spyre/torch-spyre: { mode: issues-only }   # off | issues-only | labels-only | full
#   kinds:                    # per-kind overrides; defaults in docs/acmm-policy-matrix.md
#     sentinel: { min_level: 5, require_label: true, unlabeled_min_level: 6 }
#     hold_gate_notice: { min_level: 4 }               # hive-authored PRs only, always
#   dedupe:                   # content-aware suppression of duplicate / burst comments (comment kinds with a body only)
#     enabled: true
#     same_item_ttl: 24h      # identical body on the same item is held this long
#     burst_items: 2          # distinct items that may get one body inside burst_window; the rest are held
#     burst_window: 60s
#     hourly_cap: 60          # comments per repo per kind per hour; merge-path kinds exempt; -1 disables

# Data directories — all persistent state
data:
  metrics_dir: /data/metrics
  logs_dir: /data/logs
  claude_sessions_dir: /data/home/.claude/projects
  copilot_sessions_dir: /data/home/.copilot/session-state
  agents_dir: /data/agent-configs
  # Durable root for Nous (Experiment Lab) state; HIVE_NOUS_DATA_DIR overrides.
  nous_dir: /data/nous

# Nous (Experiment Lab) runtime knobs. Durable state lives under data.nous_dir.
nous:
  # How often the hive checks <data.nous_dir>/gates/pending.json for a gate
  # the experiment agent is waiting on (RFC #11585 part 3, #11696). The
  # dashboard also checks on every GET /api/nous/gate-pending, so this only
  # bounds the owner-ping latency. HIVE_NOUS_GATE_POLL_INTERVAL overrides.
  gate_poll_seconds: 15
  # How Nous drives model calls (RFC #11585 part 5, #11698). `inline` (the
  # default) runs the campaign loop in-process through bin/nous-runner.sh;
  # `sdk` is the legacy agent-SDK mode and stays selectable. Existing configs
  # without this key get `inline`. HIVE_NOUS_DISPATCHER overrides.
  dispatcher: inline
  # Optional GitHub artifact repository (RFC #11585 part 8, #11701). Unset
  # keeps the mirror off. When set, the hive pushes each finished campaign
  # folder under data.nous_dir to this repository as a PR using its own App
  # identity (never the agent, never the owner token), after a filename
  # denylist, secret scrubbing and size caps. HIVE_NOUS_ARTIFACT_REPO /
  # _BRANCH / _PATH / _SYNC_INTERVAL override.
  # artifact_repo:
  #   repo: my-org/nous-artifacts
  #   branch: main            # default: the repository's default branch
  #   path: campaigns
  #   sync_interval_seconds: 300   # minimum 30
  # Hive-state observations (#12654). Off by default. When enabled, the
  # detectors run once per eval cycle over the snapshot series and file at
  # most max_per_week new observations per rolling 7 days (minimum 1) through
  # the hub self-report relay. Nothing is filed while a self-upgrade drain is
  # open. The budget is persisted under data.nous_dir.
  # observations:
  #   enabled: false
  #   max_per_week: 5

# Experimenter role (RFC #11585 part 5). An agent whose name or `role` is
# `experimenter` runs self-improvement campaigns through an engine implementing
# pkg/nousengine; `engine` defaults to `nous` and is only valid on this role.
# The strategist is unchanged and nothing is promoted automatically.
#
# agents:
#   experimenter:
#     role: experimenter
#     engine: nous
#     interval: 24h
