*.swp
*.bak
.DS_Store
/agent.env
/config/agent.env
examples/kubestellar/agents/agent.env

# Environment variables / credentials
.env
.env.*
*.env

# Beads ledger — runtime state, not source code
.beads/
node_modules/

# Scratch output from extracting index.html's inline <script> bodies for
# `node --check`. A build artifact of the verification step, never source.
_inline.js

# Generated local artifacts
/cov*.out
/dash.js
/pr-body.md

# Agent/session scratch: PR and issue bodies drafted for --body-file, and
# section drafts. Never source; #11588 and #14197 committed them by accident.
/pr-body.*
/issue-body.*
/issue[0-9]*.txt
/section.md

# Test-run scratch: crux/agent tests create stub CLI binaries under a
# randomly-suffixed dir. Generated per run; never part of the tree.
.hive-agent-stubs-*/

# Test-run scratch: bin/contributor-relay.test.js writes per-task status files
# into randomly-suffixed workspace dirs under here. Generated per run.
.relay-test-tmp/

# Rendered output of src/docs/design/tui.tape (VHS). The TAPE is the
# reproducible source of truth; the GIF is a build product and is not
# committed — see #5423.
src/docs/design/_out/
.gomod/

# src/crux `make build` / `make smoke` outputs: the module binary and the
# smoke test's socket + work dir. Build products, never source.
src/crux/bin/
src/crux/.smoke/
