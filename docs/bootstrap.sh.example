#!/usr/bin/env bash
# bootstrap.sh.example — RETIRED v1 installer.
#
# This file documented the original v1 supervisor/tmux deployment
# (`hive supervisor`, /etc/hive/agent.env, /opt/hive), which is no longer how
# Hive runs. Its usage header told users to pipe
#   https://raw.githubusercontent.com/hivecommons/hive/main/bin/bootstrap.sh
# into `sudo bash` — a URL that 404s: `bin/bootstrap.sh` does not exist and
# the default branch is `v4`, not `main`. See issue #6758.
#
# CURRENT INSTALL PATH: the Quick Start in the repository README —
# Docker Compose or Podman Quadlet:
#   https://github.com/hivecommons/hive#quick-start
# Full operator documentation: src/docs/README.md
#
# Maintaining a v1 deployment? Recover the old installer content from git
# history:
#   git log --all --oneline -- docs/bootstrap.sh.example
#   git show <commit>:docs/bootstrap.sh.example
echo "This v1 bootstrap installer is retired. Use the Quick Start in README.md (Docker Compose or Podman)." >&2
exit 1
